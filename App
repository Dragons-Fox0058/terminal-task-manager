import os
import sys
import json

# ---------------- BASE PATH (EXE + PY UYUMLU) ----------------
def get_base_dir():
    if getattr(sys, 'frozen', False):
        return os.path.dirname(sys.executable)
    return os.path.dirname(os.path.abspath(__file__))

BASE_DIR = get_base_dir()
FILE = os.path.join(BASE_DIR, "tasks.json")

# ---------------- LANGUAGE ----------------
LANG = "tr"

TEXTS = {
    "tr": {
        "menu": "\n1 Ekle\n2 Liste\n3 Sil\n4 Tamamla\n5 Dil\n6 Çıkış",
        "choice": "Seçim: ",
        "task": "Görev: ",
        "delete": "No: ",
        "added": "Eklendi",
        "deleted": "Silindi",
        "done": "Tamamlandı",
        "error": "Hata",
        "empty": "Boş liste",
        "lang": "Dil (tr/en/es): "
    },
    "en": {
        "menu": "\n1 Add\n2 List\n3 Delete\n4 Done\n5 Lang\n6 Exit",
        "choice": "Choice: ",
        "task": "Task: ",
        "delete": "No: ",
        "added": "Added",
        "deleted": "Deleted",
        "done": "Done",
        "error": "Error",
        "empty": "Empty list",
        "lang": "Language (tr/en/es): "
    },
    "es": {
        "menu": "\n1 Añadir\n2 Lista\n3 Borrar\n4 Hecho\n5 Idioma\n6 Salir",
        "choice": "Elegir: ",
        "task": "Tarea: ",
        "delete": "No: ",
        "added": "Añadido",
        "deleted": "Eliminado",
        "done": "Hecho",
        "error": "Error",
        "empty": "Vacío",
        "lang": "Idioma (tr/en/es): "
    }
}

# ---------------- SAFE LOAD ----------------
def load_tasks():
    try:
        if not os.path.exists(FILE):
            return []

        with open(FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

            # format kontrolü
            if isinstance(data, list):
                fixed = []
                for item in data:
                    if isinstance(item, dict) and "task" in item:
                        fixed.append({
                            "task": str(item.get("task", "")),
                            "done": bool(item.get("done", False))
                        })
                return fixed

            return []
    except:
        return []

# ---------------- SAFE SAVE ----------------
def save_tasks(tasks):
    try:
        with open(FILE, "w", encoding="utf-8") as f:
            json.dump(tasks, f, ensure_ascii=False, indent=2)
    except:
        pass

# ---------------- HELPERS ----------------
def t(key):
    return TEXTS[LANG][key]

def safe_int(val):
    try:
        return int(val)
    except:
        return None

# ---------------- INIT ----------------
tasks = load_tasks()

# ---------------- MAIN LOOP ----------------
while True:
    print(TEXTS[LANG]["menu"])

    choice = input(t("choice")).strip()

    # ADD
    if choice == "1":
        task = input(t("task")).strip()
        if task:
            tasks.append({"task": task, "done": False})
            save_tasks(tasks)
            print(t("added"))
        else:
            print(t("error"))

    # LIST
    elif choice == "2":
        if not tasks:
            print(t("empty"))
        else:
            for i, tsk in enumerate(tasks):
                status = "✔" if tsk.get("done") else "✗"
                print(f"{i+1}. {tsk['task']} [{status}]")

    # DELETE
    elif choice == "3":
        num = safe_int(input(t("delete")))
        if num and 1 <= num <= len(tasks):
            tasks.pop(num - 1)
            save_tasks(tasks)
            print(t("deleted"))
        else:
            print(t("error"))

    # DONE
    elif choice == "4":
        num = safe_int(input(t("delete")))
        if num and 1 <= num <= len(tasks):
            tasks[num - 1]["done"] = True
            save_tasks(tasks)
            print(t("done"))
        else:
            print(t("error"))

    # LANGUAGE
    elif choice == "5":
        lang = input(t("lang")).strip()
        if lang in TEXTS:
            LANG = lang

    # EXIT
    elif choice == "6":
        break

    else:
        print(t("error"))

input("Çıkmak için Enter...")
